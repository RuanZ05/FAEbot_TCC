# Copie este arquivo para .env.local e preencha os valores.

# ---------------- IA (Gemini) ----------------
# Chave gratuita em https://aistudio.google.com/apikey
# Fica SÓ no servidor (sem NEXT_PUBLIC_), nunca vai para o navegador.
# Vazia = o chat usa o buscador local (tolerante a erros de digitação).
GEMINI_API_KEY=

# Modelo do Gemini (opcional). Padrão: gemini-flash-lite-latest (o mais rápido)
GEMINI_MODEL=

# Modelos reserva, usados se o Google estiver sobrecarregado (opcional, separados por vírgula).
# Padrão: gemini-flash-latest,gemini-2.5-flash-lite,gemini-2.5-flash
GEMINI_FALLBACK_MODELS=

# ---------------- WhatsApp ----------------
# Número que recebe os encaminhamentos (só dígitos, com 55 + DDD).
# Vazio = número de teste da equipe (5524998365068).
# Produção: número oficial da FAETERJ Barra Mansa → 5524981445559
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---------------- Relatórios ----------------
# Senha para ver o resumo de avaliações em produção: /api/events?key=SUA_SENHA
ADMIN_KEY=

# ---------------- Back-end futuro ----------------
# URL da API própria (n8n + banco). Vazia = usa a rota interna /api/chat.
NEXT_PUBLIC_FAEBOT_API_URL=
